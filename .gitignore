# --- temp / diagnostic files ---
_*
*.log
*.ps1.bak

# --- local Tailwind build tool (rebuilt css is committed; the exe is not) ---
/tailwindcss.exe

# --- per-environment database settings (never commit credentials) ---
config.php

# --- user uploads: keep folder blockers + demo seed only ---
uploads/*
!uploads/.htaccess
!uploads/pasted-material.md

# --- legacy runtime storage (system now uses MySQL) ---
data/

# --- OS junk ---
Thumbs.db
.DS_Store
Desktop.ini
