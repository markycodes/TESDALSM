# LearnHub LMS — Apache config (portable: XAMPP subfolder or shared hosts like InfinityFree)

# Raise upload limits for video lessons (4 GB fits a 1080p hour-long video).
# Only applied when PHP runs as mod_php. On CGI/FastCGI hosts (InfinityFree and
# most shared hosting) php_value is not supported and would trigger an HTTP 500
# — these blocks are simply skipped there. A matching .user.ini covers
# CGI/FastCGI setups (also skipped by InfinityFree).
# The module identifier differs per build: PHP 8 registers "mod_php.c" on
# XAMPP and most distros, some distros use "mod_php8.c", PHP 7 "mod_php7.c".
<IfModule mod_php.c>
    php_value upload_max_filesize 4096M
    php_value post_max_size 4096M
    php_value max_execution_time 1200
    php_value max_input_time 7200
    php_value memory_limit 512M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 4096M
    php_value post_max_size 4096M
    php_value max_execution_time 1200
    php_value max_input_time 7200
    php_value memory_limit 512M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 4096M
    php_value post_max_size 4096M
    php_value max_execution_time 1200
    php_value max_input_time 7200
    php_value memory_limit 512M
</IfModule>

# Never serve raw app data or docs
<FilesMatch "\.(json|ini|log|md|txt)$">
    Require all denied
</FilesMatch>

# ------------------------------------------------------------
# Directory index — what the folder itself serves.
# The old landing page was renamed index.php -> learnhub.php (it is now the
# "How it works" tour beside the new home / about / FAQ pages), so this folder
# has no index.php left and a bare /LMS/ would otherwise fall back to a
# directory listing. Every other page is still reached by its own name.
# DirectoryIndex needs "AllowOverride Indexes" (XAMPP and shared hosts allow
# it); where a host refuses it, /home works exactly the same.
# ------------------------------------------------------------
DirectoryIndex home.php

# ------------------------------------------------------------
# Clean URLs — hide the .php extension in the browser address bar.
# 1) /dashboard            -> internally serves dashboard.php
# 2) /dashboard.php (GET)  -> 301 redirect to /dashboard
# POST requests are NOT redirected, so every form / CSRF flow keeps working.
# NOTE: no RewriteBase on purpose — without it mod_rewrite resolves the
# redirect against the directory containing this .htaccess, so the same file
# works in a subfolder (XAMPP: /LMS/) AND at a domain root (InfinityFree).
# A hard-coded RewriteBase (e.g. /LMS/) redirects every .php request to
# /LMS/... on hosts that serve the app from the domain root -> 404.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 0) the address the landing page used to live at: /index and /index.php
    #    (and /LMS/index, /LMS/index.php) -> the new front page. The file really
    #    was renamed, so old bookmarks and shared links should land somewhere
    #    real instead of a 404. Same full-URL trick as rule 2 below, and the
    #    pattern is anchored to a whole path segment, so a file merely
    #    containing "index" (assets/index-fixture.html) is never touched.
    RewriteCond %{THE_REQUEST} \s(/[^\s?]*/)index(?:\.php)?(?=[\s?]) [NC]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteRule ^ http://%{HTTP_HOST}%1home [R=302,L,NE]

    # 0b) The folders that may live OFF the document root.
    #     `assets/`, `logo/` and `signature/` can be deployed above public_html
    #     (a Hostinger-style layout — see paths.php). Apache can only serve a
    #     file that is under its document root, so on that layout every one of
    #     those URLs would 404. So: when the file is NOT in the document root,
    #     hand the request to asset.php, which reads it from wherever it really
    #     lives (config.php's LH_STORAGE_DIR).
    #     INTERNAL rewrite — no [R] — so the address bar keeps the URL the page
    #     printed. That is not cosmetic: a browser resolves a stylesheet's
    #     relative url(../logo/x.png) against the stylesheet's own address, so
    #     serving the CSS from a different address would silently move every
    #     font and image inside it.
    #     When the folders ARE beside the PHP (XAMPP, and any host that keeps
    #     them in public_html) the file exists, the condition fails, and Apache
    #     serves the bytes itself — no PHP in the path and no cost, exactly as
    #     before. data/ and uploads/ are deliberately absent: they are never
    #     linked, and stream through download.php / avatar.php / read.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(assets|logo|signature)/(.+)$ asset.php?lh_asset=$1/$2 [L,QSA]

    # 1) map the extensionless path to the real .php file (internal, no URL change)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteCond %{REQUEST_URI} !\.php$
    RewriteRule ^(.+)$ $1.php [L]

    # 2) external redirect: /dashboard.php (GET) -> /dashboard (absolute URL)
    # AJAX/heartbeat endpoints keep their .php: one request instead of a
    # redirect chain (shared-host security systems challenge every hop, and
    # doubled poll traffic can trip their rate limits).
    # The target path is captured from THE_REQUEST (as the client asked for it:
    # /LMS/dashboard.php on XAMPP, /dashboard.php at a domain root) and the
    # redirect is emitted as a FULL URL with the request's own host.
    # Why fully-qualified: in per-directory context, mod_rewrite prepends the
    # perdir (a FILESYSTEM path) to any non-absolute substitution and then tries
    # to strip the docroot back off to build the Location. When that strip fails
    # (XAMPP: "http://127.0.0.1/C:/xampp/htdocs/LMS/dashboard", InfinityFree:
    # "https://site/home/vol11_5/.../htdocs/dashboard") the filesystem path
    # leaks into the URL and Apache 403s it. An absolute URL is passed through
    # verbatim — no RewriteBase and no filesystem->URL conversion needed.
    # 302 (not 301): browsers cache 301s permanently; 302 is always re-evaluated.
    # Profile pictures join the no-redirect list: an <img> in the top bar is asked
    # for on every single page view, and a circle should not cost two requests
    # each time just to hide a file extension nobody sees anyway.
    RewriteCond %{REQUEST_URI} !^/([^/]+/)?(realtime|ping|presence|read_progress|watch|live_class|avatar|asset|read|download|download_submission|offline|upload|upload_chunk|mark_messages_read|mark_notifications_read|login|logout)\.php$ [NC]
    RewriteCond %{THE_REQUEST} \s(/[^\s?]+)(?=\.php) [NC]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteRule ^ http://%{HTTP_HOST}%1 [R=302,L,NE]

    # 3) directories first (e.g. /uploads) and real files (css/js/images) pass through untouched
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>

# allow multi-GB bodies (default is unlimited, but make it explicit)
LimitRequestBody 0
