# LearnHub LMS — Apache config (portable: XAMPP subfolder or shared hosts like InfinityFree)

# Raise upload limits for video lessons.
# Only applied when PHP runs as mod_php (XAMPP). On CGI/FastCGI hosts
# (InfinityFree and most shared hosting) php_value is not supported and
# would trigger an HTTP 500 — these blocks are simply skipped there.
<IfModule mod_php8.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 512M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 512M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

# Never serve raw app data or docs
<FilesMatch "\.(json|ini|log|md|txt)$">
    Require all denied
</FilesMatch>

# ------------------------------------------------------------
# Clean URLs — hide the .php extension in the browser address bar.
# 1) /dashboard            -> internally serves dashboard.php
# 2) /dashboard.php (GET)  -> 301 redirect to /dashboard
# POST requests are NOT redirected, so every form / CSRF flow keeps working.
# NOTE: no RewriteBase on purpose — without it mod_rewrite resolves the
# redirect against the directory containing this .htaccess, so the same file
# works in a subfolder (XAMPP: /LMS/) AND at a domain root (InfinityFree).
# A hard-coded RewriteBase (e.g. /LMS/) redirects every .php request to
# /LMS/... on hosts that serve the app from the domain root -> 404.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) map the extensionless path to the real .php file (internal, no URL change)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteCond %{REQUEST_URI} !\.php$
    RewriteRule ^(.+)$ $1.php [L]

    # 2) external redirect: /dashboard.php (GET) -> /dashboard (directory-relative)
    RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.php[\s?] [NC]
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteRule ^(.+)\.php$ $1 [R=301,L,NE]

    # 3) directories first (e.g. /uploads) and real files (css/js/images) pass through untouched
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>
